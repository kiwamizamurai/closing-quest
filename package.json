{
  "name": "closing-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "1年間の経理業務を体験して学ぶ 3D すごろく（月次決算がサブゴール）",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:docs": "tsc --noEmit && vite build --outDir docs --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
